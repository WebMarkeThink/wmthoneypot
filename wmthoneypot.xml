<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="system" method="upgrade">
	<name>plg_system_wmthoneypot</name>
	<author>WebMarkeThink</author>
	<authorUrl>https://www.webmarkethink.it</authorUrl>
	<creationDate>2026-09</creationDate>
	<copyright>(C) 2026 WebMarkeThink</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<version>1.0.0</version>
	<description>PLG_SYSTEM_WMTHONEYPOT_XML_DESCRIPTION</description>
	<namespace path="src">Wmt\Plugin\System\WmtHoneypot</namespace>
	<files>
		<folder plugin="wmthoneypot">services</folder>
		<folder>src</folder>
		<filename>LICENSE.txt</filename>
	</files>
	<languages>
		<language tag="en-GB">language/en-GB/plg_system_wmthoneypot.ini</language>
		<language tag="en-GB">language/en-GB/plg_system_wmthoneypot.sys.ini</language>
		<language tag="it-IT">language/it-IT/plg_system_wmthoneypot.ini</language>
		<language tag="it-IT">language/it-IT/plg_system_wmthoneypot.sys.ini</language>
	</languages>
	<changelogurl>https://raw.githubusercontent.com/WebMarkeThink/wmthoneypot/main/changelog.xml</changelogurl>
	<updateservers>
		<server type="extension" priority="1" name="WmtHoneypot">https://updates.webmarkethink.it/hpupdates.xml</server>
	</updateservers>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="field_name"
					type="text"
					label="PLG_SYSTEM_WMTHONEYPOT_FIELD_NAME_LABEL"
					description="PLG_SYSTEM_WMTHONEYPOT_FIELD_NAME_DESC"
					default="wmt_conferma"
					filter="cmd"
				/>
				<field
					name="min_seconds"
					type="number"
					label="PLG_SYSTEM_WMTHONEYPOT_MIN_SECONDS_LABEL"
					description="PLG_SYSTEM_WMTHONEYPOT_MIN_SECONDS_DESC"
					default="4"
					min="0"
					max="120"
					filter="integer"
				/>
				<field
					name="max_hours"
					type="number"
					label="PLG_SYSTEM_WMTHONEYPOT_MAX_HOURS_LABEL"
					description="PLG_SYSTEM_WMTHONEYPOT_MAX_HOURS_DESC"
					default="24"
					min="1"
					max="720"
					filter="integer"
				/>
				<field
					name="log"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					label="PLG_SYSTEM_WMTHONEYPOT_LOG_LABEL"
					description="PLG_SYSTEM_WMTHONEYPOT_LOG_DESC"
					default="1"
					>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
			<fieldset name="advanced" label="PLG_SYSTEM_WMTHONEYPOT_ADVANCED">
				<field
					name="forms"
					type="textarea"
					label="PLG_SYSTEM_WMTHONEYPOT_FORMS_LABEL"
					description="PLG_SYSTEM_WMTHONEYPOT_FORMS_DESC"
					default="com_contact.contact"
					rows="4"
					filter="string"
				/>
				<field
					name="message"
					type="text"
					label="PLG_SYSTEM_WMTHONEYPOT_MESSAGE_LABEL"
					description="PLG_SYSTEM_WMTHONEYPOT_MESSAGE_DESC"
					filter="string"
				/>
			</fieldset>
		</fields>
	</config>
</extension>
